# ==============================================================
# Servidor e Conexão
# ==============================================================
PORT=3000 # Define a porta em que o servidor irá rodar. Padrão original: 3000.
# HOST=0.0.0.0 # Define a interface de rede. Padrão: 0.0.0.0 (aceita conexões externas)
# API_KEY=your_proxy_api_key # Senha de acesso da sua API proxy. Deixe vazio para não exigir autenticação. Padrão: vazio.

# ==============================================================
# Contas Qwen (Suporte a Múltiplas Contas - Fork mcatatau)
# Nota Dodo: Contas gerenciadas via interface do Launcher são salvas no banco de dados SQLite.
# ==============================================================
# QWEN_EMAIL=your_email@example.com # Email da conta primária. Padrão: vazio.
# QWEN_PASSWORD=your_password # Senha da conta primária. Padrão: vazio.
# QWEN_EMAIL_1=second@example.com # Email da conta secundária. Padrão: vazio.
# QWEN_PASSWORD_1=your_password # Senha da conta secundária. Padrão: vazio.
# QWEN_GUEST_MODE_ONLY=false # Força o uso exclusivo do modo visitante (Guest) sem login. Padrão: false.

# ==============================================================
# Endpoints Qwen (Upstream)
# ==============================================================
# QWEN_BASE_URL=https://chat.qwen.ai # URL base oficial do Qwen. Padrão: https://chat.qwen.ai
# QWEN_HTTP_ENDPOINT=https://api.qwen.ai/v1/chat # Endpoint para requisições via HTTP nativo (se necessário). Padrão: https://api.qwen.ai/v1/chat
# QWEN_API_KEY= # Chave de API oficial do Qwen caso use o endpoint HTTP. Padrão: vazio.

# ==============================================================
# Configuração do Playwright / Navegador
# ==============================================================
# BROWSER=chromium # Define o motor do navegador. Opções: chromium, firefox, webkit, chrome, edge. Padrão: chromium.
HEADLESS=false # Define se o navegador roda de forma invisível. Padrão: true.
# USER_DATA_DIR=./qwen_profiles # Pasta onde os cookies e perfis (bypass) são salvos. Padrão: ./qwen_profiles.
# USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36 # Identificação do navegador. Padrão: agent do linux/windows.
LOG_CONSOLE=true # Exibe os logs internos do console do navegador no seu terminal. Padrão: false.

# ==============================================================
# Timeouts (Milissegundos) - Dodo Config
# ==============================================================
NAVIGATION_TIMEOUT=45000 # Tempo limite para carregar páginas no navegador. Padrão: 45000.
PAGE_TIMEOUT=30000 # Tempo limite para aguardar elementos visuais na interface. Padrão: 30000.
HTTP_TIMEOUT=30000 # Tempo limite para requisições de rede (fetch) dentro do Playwright. Padrão: 30000.
HEADERS_TIMEOUT=60000 # Tempo limite esperando o token bx-ua aparecer. Padrão: 60000.
CHAT_TIMEOUT=120000 # Tempo máximo total aguardando resposta de stream no chat. Padrão: 120000.
# STREAM_IDLE_TIMEOUT=180000 # Tempo limite de inatividade (sem novos chunks) do stream upstream. Padrão: 180000.

# ==============================================================
# Otimização e Cache
# ==============================================================
# CACHE_TTL=3600 # Tempo de vida (em segundos) do cache de headers. Padrão: 3600 (1 hora).
# RESPONSE_TTL=1800 # Tempo de vida do cache de respostas. Padrão: 1800 (30 minutos).

# ==============================================================
# Watchdog e Monitoramento de Recursos
# ==============================================================
# METRICS_INTERVAL=10000 # A cada quantos ms o sistema relata uso de CPU/RAM. Padrão: 10000.
# WATCHDOG_INTERVAL=5000 # A cada quantos ms o cão de guarda verifica falhas. Padrão: 5000.
# WATCHDOG_FAILURES=3 # Máximo de falhas seguidas antes de engatilhar ação de defesa. Padrão: 3.
# RAM_WARNING=80 # Alerta de consumo de RAM em porcentagem. Padrão: 80.
# RAM_CRITICAL=95 # Limite crítico de RAM antes de reinicializar instâncias pesadas. Padrão: 95.
# WS_WARNING=50 # Alerta de excesso de conexões WebSocket. Padrão: 50.
# WS_CRITICAL=100 # Limite crítico de WebSockets. Padrão: 100.
